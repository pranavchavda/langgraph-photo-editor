# API Keys - Add these through the web interface or set them here
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: Remove.bg API (if you have it)
# REMOVE_BG_API_KEY=

# Background Removal Settings
BACKGROUND_REMOVAL_METHOD=rembg  # Options: auto, remove.bg, rembg
REMBG_MODEL=bria-rmbg           # Best model for product photos
REMBG_ALPHA_MATTING=false       # Set to true for smoother edges (slower)

# Quality Settings
QUALITY_PRESET=ultra             # Options: maximum, ultra, high, balanced, web
REMOVEBG_SIZE=full              # Options: preview, auto, small, medium, hd, 4k, full, 50MP

# Processing Settings
MAX_CONCURRENT_IMAGES=3         # Process 3 images at once
RETRY_ATTEMPTS=2                # Retry failed images twice
QUALITY_THRESHOLD=0.8           # Minimum QC score

# ImageMagick Settings (optional)
# IMAGEMAGICK_GAMMA=1.0
# IMAGEMAGICK_SATURATION=108
# IMAGEMAGICK_QUALITY=100
